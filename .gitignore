# ── Virtual environment ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Python cache & compiled files ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Trained model binaries (regenerate via src/train.py) ────────────────────
models/*.pkl
models/*.joblib

# ── Large raw data files ─────────────────────────────────────────────────────
# CSV files are committed selectively — see note below
train-test.csv
validation.csv

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
*.secret

# ── IDE & OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary / scratch ──────────────────────────────────────────────────────
tmp/
temp/
scratch/

# ── MS Office temp lock files ─────────────────────────────────────────────────
~$*
